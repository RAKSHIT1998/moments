	<string>MOMENT syncs Moments directly with nearby phones over Wi‑Fi and Bluetooth, so friends in the same room get them instantly — no server involved.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_mmt-mesh._tcp</string>
		<string>_mmt-mesh._udp</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.rakshitbargotra.moment</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>moment</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>MomentPrivacyPolicyURL</key>
	<string></string>
	<key>MomentSupportURL</key>
	<string></string>
	<key>MomentTermsURL</key>
	<string>https://www.apple.com/legal/internet-services/itunes/dev/stdeula/</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Optional. Use your calendar as context for what matters this week. MOMENT never adds or changes events without asking you first.</string>
	<key>NSCameraUsageDescription</key>
	<string>Use your camera to scan documents and screens into Moments. Scans are processed on this iPhone.</string>
	<key>NSContactsUsageDescription</key>
	<string>Optional. Link a person in MOMENT to one of your contacts. MOMENT never imports your address book.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Lock your Moments so only you can open them.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Attach a city-level place to a Moment. Never your exact location.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Use your microphone to turn voice notes into Moments.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose photos to add to a Moment.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Use speech recognition to understand your voice Moments. On-device recognition is used when your iPhone supports it.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>CaptureMomentIntent</string>
		<string>SearchMemoriesIntent</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
