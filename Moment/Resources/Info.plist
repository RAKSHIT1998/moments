			<string>com.rakshitbargotra.moment.package</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>moment</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.moment+json</string>
				</array>
			</dict>
		</dict>
	</array>
